# Copy to `.env` and fill in. Every key is optional — the system runs in
# DEMO mode with sensible fallbacks if a key is missing.

# --- OpenRouter (free Hermes models work great here) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
OPENROUTER_REFERER=https://localhost
OPENROUTER_TITLE=CryptoAdsAgents

# --- Apify (optional — used for Polymarket / Kalshi scrapers) ---
APIFY_TOKEN=
# Use cheerio-scraper for OHLC fetches — fast, no Chromium cold-start.
APIFY_POLYMARKET_ACTOR=apify/cheerio-scraper
APIFY_KALSHI_ACTOR=apify/cheerio-scraper

# --- Risk / capital ---
BANKROLL_USD=1000
MAX_KELLY_FRACTION=0.25      # cap aggressive Kelly bets at 25%
MIN_EDGE=0.02                # ignore signals with edge < 2 %

# --- Universe (comma separated) ---
ASSETS=BTC,ETH

# --- Loop cadence ---
LOOP_SECONDS=60              # how often the orchestrator wakes up

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# --- Predictor ---
# Default predictor for the live cycle and the backtester.
# auto         = use Kronos if installed, else statistical
# statistical  = always use Markov + EMA baseline
# kronos       = use the configured Kronos size
# kronos-mini  | kronos-small | kronos-base
PREDICTOR_DEFAULT=auto

# --- Kronos (optional, deep-learning predictor) -----------------------
# Install path A (recommended for the official model):
#   git clone https://github.com/NeoQuasar/Kronos.git
#   pip install -r Kronos/requirements.txt
#   set KRONOS_REPO_PATH to the absolute path of the clone
KRONOS_REPO_PATH=

# Choose your default size: mini | small | base
KRONOS_MODEL_SIZE=small

# Override the model location with a local directory of weights.
# Leave empty to download from Hugging Face under NeoQuasar/Kronos-<size>.
KRONOS_MODEL_PATH=

# Tokenizer repo id or local path. Tokenizer-base works with mini/small/base.
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base

# auto | cpu | cuda | cuda:0 ...
KRONOS_DEVICE=auto

# Context window for Kronos (max input bars).
KRONOS_MAX_CONTEXT=512

# Sampling knobs (see NeoQuasar/Kronos README for details).
KRONOS_T=1.0
KRONOS_TOP_P=0.9
KRONOS_SAMPLE_COUNT=1
